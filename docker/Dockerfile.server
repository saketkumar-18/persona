# ---------------------------------------------------------------------------
# Persona API server (NestJS)
# ---------------------------------------------------------------------------
FROM node:22-alpine AS base
WORKDIR /app

# ---- monorepo dependency install (cached) ----
COPY package.json package-lock.json* ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/server/package.json ./apps/server/
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

# ---- source ----
COPY package.json ./
COPY packages/shared ./packages/shared
COPY apps/server ./apps/server

# ---- build shared first (server depends on its dist) ----
RUN npm run build -w @persona/shared && npm run build -w @persona/server

FROM node:22-alpine AS runner
ENV NODE_ENV=production
WORKDIR /app

RUN addgroup -S persona && adduser -S persona -G persona

COPY --from=base /app/package.json ./package.json
COPY --from=base /app/node_modules ./node_modules
COPY --from=base /app/packages/shared ./packages/shared
COPY --from=base /app/apps/server/package.json ./apps/server/
COPY --from=base /app/apps/server/dist ./apps/server/dist

USER persona
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null "http://localhost:${PORT:-3000}/api/health" || exit 1

CMD ["node", "apps/server/dist/main.js"]
