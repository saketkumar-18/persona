# ---------------------------------------------------------------------------
# GhostLink web frontend (Next.js standalone) — Fly.io
# ---------------------------------------------------------------------------
FROM node:22-alpine AS base
WORKDIR /app

# ---- dependency install (cached) ----
COPY package.json package-lock.json* ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

# ---- build: NEXT_PUBLIC_* values are inlined at build time ----
FROM base AS builder
ARG NEXT_PUBLIC_API_URL=http://localhost:3000
ARG NEXT_PUBLIC_WS_URL=http://localhost:3000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV SKIP_ENV_VALIDATION=true

COPY package.json ./
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web

RUN npm run generate-icons \
 && npm run build -w @ghostlink/shared -w @ghostlink/web \
 && mkdir -p /output/public \
 && cp -r apps/web/.next/standalone/. /output/ \
 && cp -r apps/web/.next/static apps/web/.next/standalone/apps/web/.next/static 2>/dev/null || cp -r apps/web/.next/static /output/apps/web/.next/static \
 && cp -r apps/web/public/. /output/apps/web/public/

# ---- runner: standalone server only ----
FROM node:22-alpine AS runner
ENV NODE_ENV=production
WORKDIR /app

RUN addgroup -S ghostlink && adduser -S ghostlink -G ghostlink
COPY --from=builder --chown=ghostlink:ghostlink /output ./

USER ghostlink
ENV PORT=3001
ENV HOSTNAME=0.0.0.0
EXPOSE 3001

CMD ["node", "apps/web/server.js"]
