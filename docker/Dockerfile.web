# ---------------------------------------------------------------------------
# GhostLink web frontend (Next.js)
# ---------------------------------------------------------------------------
FROM node:22-alpine AS base
WORKDIR /app

# ---- dependency install (cached) ----
COPY package.json package-lock.json* ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

# ---- build (needs NEXT_PUBLIC_* at build time, inlined by Webpack) ----
FROM base AS builder
ARG NEXT_PUBLIC_API_URL=http://localhost:3000
ARG NEXT_PUBLIC_WS_URL=http://localhost:3000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV SKIP_ENV_VALIDATION=true

COPY package.json ./
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web

RUN npm run generate-icons && npm run build -w @ghostlink/shared -w @ghostlink/web

# ---- runner ----
FROM node:22-alpine AS runner
ENV NODE_ENV=production
WORKDIR /app

RUN addgroup -S ghostlink && adduser -S ghostlink -G ghostlink

COPY --from=builder --chown=ghostlink:ghostlink /app/apps/web/.next ./apps/web/.next
COPY --from=builder --chown=ghostlink:ghostlink /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=ghostlink:ghostlink /app/apps/web/package.json ./apps/web/
COPY --from=builder --chown=ghostlink:ghostlink /app/node_modules ./node_modules
COPY --from=builder --chown=ghostlink:ghostlink /app/package.json ./

USER ghostlink
EXPOSE 3001
ENV PORT=3001

CMD ["npm", "run", "start", "-w", "@ghostlink/web"]
