# ---------------------------------------------------------------------------
# Persona web frontend (Next.js)
# ---------------------------------------------------------------------------
FROM node:22-alpine AS base
WORKDIR /app

# ---- dependency install (cached) ----
COPY package.json package-lock.json* ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

# ---- build ----
# The deployed frontend calls API/WS on its own origin (same-origin default),
# so no NEXT_PUBLIC_* build args are needed — one URL serves everything.
FROM base AS builder
ENV SKIP_ENV_VALIDATION=true

COPY package.json ./
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web

RUN npm run build -w @persona/shared -w @persona/web

# ---- runner ----
FROM node:22-alpine AS runner
ENV NODE_ENV=production
WORKDIR /app

RUN addgroup -S persona && adduser -S persona -G persona

COPY --from=builder --chown=persona:persona /app/apps/web/.next ./apps/web/.next
COPY --from=builder --chown=persona:persona /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=persona:persona /app/apps/web/package.json ./apps/web/
COPY --from=builder --chown=persona:persona /app/node_modules ./node_modules
COPY --from=builder --chown=persona:persona /app/package.json ./

USER persona
EXPOSE 3001
ENV PORT=3001

CMD ["npm", "run", "start", "-w", "@persona/web"]
