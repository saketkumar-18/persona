# ---------------------------------------------------------------------------
# Persona environment configuration
# Copy to .env (root) and adjust values. This file is safe to commit.
# .env / .env.local files are gitignored and must never be committed.
# Never place secrets in this list — values here must be non-secret defaults.
# ---------------------------------------------------------------------------

# --- General ---
NODE_ENV=development
PERSONA_PUBLIC_URL=http://localhost:3001

# --- Server (apps/server) ---
SERVER_PORT=3000
REDIS_URL=redis://localhost:6379
# Keys exist in server code with secure generated defaults. Override here in
# production so JWT/control-code HMACs stay stable across restarts/replicas.
SESSION_JWT_SECRET=
SESSION_JWT_TTL_SECONDS=14400
PARTNER_CONTROL_SECRET=
## Adds a fixed operational latency (ms) to every session-session route.
# OUTBOUND_LATENCY_MS=0

# --- Matching / Discovery ---
NEARBY_DEFAULT_RADIUS_METERS=3000

# --- Session lifetimes (seconds) ---
DEFAULT_SESSION_TTL_SECONDS=14400
MAX_SESSION_TTL_SECONDS=86400
DEFAULT_ROOM_TTL_SECONDS=3600
MAX_ROOM_TTL_SECONDS=86400

# --- Pools ---
MAX_INVITES_PER_SESSION=30
MAX_REPORTS_PER_SESSION=20

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
THROTTLE_LIMIT=150

# --- CORS ---
# Comma-separated origins. Empty = same-origin only (localhost dev routes included automatically).
ALLOWED_ORIGINS=http://localhost:3001

# --- Web (apps/web) ---
# Server base URL (SSR fetches) and browser URL (client fetches).
# WS URL: socket.io connects on the /socket.io path of this origin.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:3000

# --- Docker ---
REDIS_PASSWORD=change-me-in-production
